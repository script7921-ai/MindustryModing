#the mod name as displayed in-game
displayName: "Bio: Virolix"

#the internal name of your mod
name: "bio-virolix"

#your name
author: "You"

#the fully qualified main class of the mod
main: "bio.BioVirolixMod"

#the mod description as seen in the mod dialog
description: "A living biomass planet for Mindustry. Sapient spores, symbiotic blocks and a hostile biosphere."

#the mod version
version: 0.1.0

#the minimum game build required to run this mod
minGameVersion: 160.3

#this is a java mod
java: true
